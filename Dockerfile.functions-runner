FROM node:22-bookworm-slim AS tools
WORKDIR /tools
RUN npm install --no-audit --no-fund --save-exact \
    @bytecodealliance/componentize-js@0.21.0 esbuild@0.25.12 es-module-lexer@1.7.0

FROM rust:1.91-bookworm AS build
WORKDIR /src
COPY --from=tools /tools /tools
COPY kernel-rs ./kernel-rs
ENV KONAE_STARLING_TOOLS=/tools
RUN cargo build --release --locked --manifest-path kernel-rs/functions-runner-wasm/Cargo.toml \
  && cargo build --release --locked --manifest-path kernel-rs/functions-runner/Cargo.toml \
  && cargo build --release --locked --manifest-path kernel-rs/functions-prepare/Cargo.toml \
  && install -D -m 755 kernel-rs/functions-runner-wasm/target/release/konae-functions-runner-wasm /out/konae-functions-runner-wasm \
  && install -D -m 755 kernel-rs/functions-runner/target/release/konae-functions-runner /out/konae-functions-runner-deno \
  && install -D -m 755 kernel-rs/functions-prepare/target/release/konae-functions-prepare /out/konae-functions-prepare

FROM scratch AS artifact
COPY --from=build /out/konae-functions-runner-wasm /konae-functions-runner-wasm
COPY --from=build /out/konae-functions-runner-deno /konae-functions-runner-deno
COPY --from=build /out/konae-functions-prepare /konae-functions-prepare
