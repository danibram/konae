FROM rust:1.91-bookworm AS build

WORKDIR /src
COPY kernel-rs/functions-executor/Cargo.toml ./kernel-rs/functions-executor/Cargo.toml
COPY kernel-rs/functions-executor/src/ ./kernel-rs/functions-executor/src/
COPY spikes/functions-runtime/rust-host/Cargo.toml spikes/functions-runtime/rust-host/Cargo.lock spikes/functions-runtime/rust-host/build.rs ./spikes/functions-runtime/rust-host/
COPY spikes/functions-runtime/rust-host/src/ ./spikes/functions-runtime/rust-host/src/
RUN cargo build --release --locked \
    --manifest-path spikes/functions-runtime/rust-host/Cargo.toml \
    --bin konae-functions-spike \
  && install -D -m 755 \
    spikes/functions-runtime/rust-host/target/release/konae-functions-spike \
    /out/konae-functions-spike

FROM scratch AS artifact
COPY --from=build /out/konae-functions-spike /konae-functions-spike
