diff --git a/kernel-rs/kernel/src/functions/tracing_probe.rs b/kernel-rs/kernel/src/functions/tracing_probe.rs
new file mode 100644
--- /dev/null
+++ b/kernel-rs/kernel/src/functions/tracing_probe.rs
@@ -0,0 +1,192 @@
+use axum::{
+    http::{HeaderMap, HeaderValue},
+    response::Response,
+};
+use std::{
+    io::{self, Write},
+    sync::{Arc, Mutex, OnceLock, mpsc},
+    time::Instant,
+};
+
+const CAPACITY: usize = 160;
+
+#[derive(Clone, Copy)]
+pub(super) enum Phase {
+    Admission,
+    WorkerWait,
+    Preparation,
+    Worker(bool),
+    Initialization,
+    Handler,
+    Action(&'static str),
+    Sqlite,
+}
+
+#[derive(Clone)]
+pub(super) struct Probe(Arc<Capture>);
+
+struct Capture {
+    started: Instant,
+    traceparent: Option<String>,
+    records: Mutex<Vec<Record>>,
+}
+
+struct Record {
+    phase: Phase,
+    start_ns: u64,
+    duration_ns: u64,
+    rows_read: u32,
+    rows_written: u32,
+    bytes: u32,
+    code: Option<&'static str>,
+}
+
+pub(super) struct Timing<'a> {
+    capture: &'a Capture,
+    phase: Phase,
+    start: Instant,
+    pub rows_read: u32,
+    pub rows_written: u32,
+    pub bytes: u32,
+    pub code: Option<&'static str>,
+}
+
+impl Drop for Timing<'_> {
+    fn drop(&mut self) {
+        let record = Record {
+            phase: self.phase,
+            start_ns: self.start.duration_since(self.capture.started).as_nanos() as u64,
+            duration_ns: self.start.elapsed().as_nanos() as u64,
+            rows_read: self.rows_read,
+            rows_written: self.rows_written,
+            bytes: self.bytes,
+            code: self.code,
+        };
+        let mut records = self.capture.records.lock().unwrap();
+        if records.len() < CAPACITY {
+            records.push(record);
+        }
+    }
+}
+
+struct Report {
+    records: Vec<Record>,
+    response_ns: u64,
+    status: u16,
+}
+
+fn submit(report: Report) {
+    static SENDER: OnceLock<mpsc::SyncSender<Report>> = OnceLock::new();
+    let sender = SENDER.get_or_init(|| {
+        let (sender, receiver) = mpsc::sync_channel::<Report>(256);
+        std::thread::spawn(move || {
+            for report in receiver {
+                std::hint::black_box((report.response_ns, report.status));
+                for record in report.records {
+                    let label = match record.phase {
+                        Phase::Action(name) => name,
+                        Phase::Worker(true) => "cold",
+                        Phase::Worker(false) => "warm",
+                        _ => "",
+                    };
+                    std::hint::black_box((
+                        label,
+                        record.start_ns,
+                        record.duration_ns,
+                        record.rows_read,
+                        record.rows_written,
+                        record.bytes,
+                        record.code,
+                    ));
+                }
+            }
+        });
+        sender
+    });
+    let _ = sender.try_send(report);
+}
+
+impl Probe {
+    pub(super) fn from_headers(headers: &HeaderMap, started: Instant) -> Option<Self> {
+        let mode = headers.get("x-konae-tracing-probe")?.to_str().ok()?;
+        let traceparent = match mode {
+            "metrics" => None,
+            "trace" => {
+                let trace_id = uuid::Uuid::new_v4().simple();
+                let span_id = uuid::Uuid::new_v4();
+                Some(format!(
+                    "00-{trace_id}-{}-01",
+                    hex::encode(&span_id.as_bytes()[..8])
+                ))
+            }
+            _ => return None,
+        };
+        Some(Self(Arc::new(Capture {
+            started,
+            traceparent,
+            records: Mutex::new(Vec::with_capacity(32)),
+        })))
+    }
+
+    pub(super) fn begin(probe: &Option<Self>, phase: Phase) -> Option<Timing<'_>> {
+        let capture = &probe.as_ref()?.0;
+        if capture.traceparent.is_none() && !matches!(phase, Phase::Action(_) | Phase::Sqlite) {
+            return None;
+        }
+        Some(Timing {
+            capture,
+            phase,
+            start: Instant::now(),
+            rows_read: 0,
+            rows_written: 0,
+            bytes: 0,
+            code: None,
+        })
+    }
+
+    pub(super) fn finish(probe: Option<Self>, response: &mut Response, started: Instant) {
+        if let Some(probe) = probe {
+            let records = std::mem::take(&mut *probe.0.records.lock().unwrap());
+            let actions = records
+                .iter()
+                .filter(|r| matches!(r.phase, Phase::Action(_)))
+                .count();
+            let sqlite = records
+                .iter()
+                .filter(|r| matches!(r.phase, Phase::Sqlite))
+                .count();
+            let headers = response.headers_mut();
+            headers.insert("x-konae-probe-actions", HeaderValue::from(actions as u64));
+            headers.insert("x-konae-probe-sqlite", HeaderValue::from(sqlite as u64));
+            if let Some(traceparent) = &probe.0.traceparent {
+                headers.insert("traceparent", HeaderValue::from_str(traceparent).unwrap());
+            }
+            submit(Report {
+                records,
+                response_ns: started.elapsed().as_nanos() as u64,
+                status: response.status().as_u16(),
+            });
+        }
+        response.headers_mut().insert(
+            "x-konae-probe-server-ns",
+            HeaderValue::from(started.elapsed().as_nanos() as u64),
+        );
+    }
+}
+
+pub(super) fn json_size(value: &serde_json::Value) -> u32 {
+    #[derive(Default)]
+    struct Count(u32);
+    impl Write for Count {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            self.0 += bytes.len() as u32;
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut count = Count::default();
+    serde_json::to_writer(&mut count, value).unwrap();
+    count.0
+}
