{
  "version": 1,
  "actions": {
    "pushes.receive": {
      "kind": "mutation",
      "access": "anonymous",
      "http": { "method": "POST", "path": "/hooks/push", "signature": { "header": "X-Hub-Signature-256", "secret": "push_hook" } },
      "statement": "INSERT INTO events (source, ref, detail, received_at) VALUES ('push', ?1, ?2, ?3)",
      "bindings": [
        { "source": "input", "key": "ref", "type": "string", "maxLength": 200 },
        { "source": "input", "key": "after", "type": "string", "maxLength": 64 },
        { "source": "kernel", "field": "now" }
      ]
    },
    "deploys.receive": {
      "kind": "mutation",
      "access": "anonymous",
      "http": { "method": "POST", "path": "/hooks/deploy" },
      "statement": "INSERT INTO events (source, ref, detail, received_at) VALUES ('deploy', ?1, ?2, ?3)",
      "bindings": [
        { "source": "input", "key": "ref", "type": "string", "maxLength": 200 },
        { "source": "input", "key": "detail", "type": "string", "maxLength": 4000, "nullable": true },
        { "source": "kernel", "field": "now" }
      ]
    },
    "events.feed": {
      "kind": "query",
      "access": "anonymous",
      "http": { "method": "GET", "path": "/api/events", "callers": ["key"] },
      "statement": "SELECT id, source, ref, detail FROM events WHERE (?1 IS NULL OR id > ?1) ORDER BY id LIMIT 100",
      "bindings": [{ "source": "input", "key": "after", "type": "number", "nullable": true }]
    }
  }
}
