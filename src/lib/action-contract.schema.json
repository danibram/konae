{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Konae Action Contract",
  "description": "Every Server Action of one Capsule: inputs, output shape, callers, HTTP binding, errors and limits. Generated from actions.json and schema.sql by src/lib/action-contract.ts.",
  "type": "object",
  "required": ["format", "version", "errors", "actions", "notes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "konae-action-contract" },
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
    },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "actions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/action" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["name", "kind", "access", "actorBound", "inputs", "output", "runtime", "errors", "limits", "statement", "bindings"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["query", "mutation", "signal", "call"] },
        "access": { "enum": ["anonymous", "authenticated"] },
        "actorBound": { "type": "boolean" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "output": { "oneOf": [{ "$ref": "#/$defs/rows" }, { "$ref": "#/$defs/changes" }, { "$ref": "#/$defs/signal" }, { "$ref": "#/$defs/queued" }] },
        "signal": {
          "type": "object",
          "required": ["name", "properties"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "properties": { "type": "array", "items": { "type": "string" } } }
        },
        "guard": { "type": "string", "minLength": 1, "maxLength": 200 },
        "notify": {
          "type": "object",
          "required": ["to", "subject", "body"],
          "additionalProperties": false,
          "properties": {
            "to": { "enum": ["owner", "actor"] },
            "subject": { "type": "string", "minLength": 1, "maxLength": 120 },
            "body": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        "schedule": {
          "oneOf": [
            { "type": "object", "required": ["every"], "additionalProperties": false, "properties": { "every": { "type": "string", "pattern": "^[1-9][0-9]{0,4}[mh]$" } } },
            { "type": "object", "required": ["daily"], "additionalProperties": false, "properties": { "daily": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } } }
          ]
        },
        "call": { "$ref": "#/$defs/call" },
        "thenOf": { "type": "string" },
        "runtime": {
          "type": "object",
          "required": ["endpoint", "tool", "sdk", "callers"],
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string" },
            "tool": { "type": "string" },
            "sdk": { "type": "string" },
            "callers": { "type": "array", "items": { "$ref": "#/$defs/caller" } }
          }
        },
        "http": { "$ref": "#/$defs/http" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "limits": { "$ref": "#/$defs/limits" },
        "statement": { "type": "string" },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } }
      }
    },
    "input": {
      "type": "object",
      "required": ["key", "type", "required", "nullable"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "type": { "enum": ["string", "number", "boolean"] },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1 }
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "type", "nullable"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["integer", "real", "text", "blob", "numeric", "any", "unknown"] },
        "nullable": { "type": ["boolean", "null"] },
        "from": {
          "type": "object",
          "required": ["table", "column"],
          "additionalProperties": false,
          "properties": { "table": { "type": "string" }, "column": { "type": "string" } }
        }
      }
    },
    "rows": {
      "type": "object",
      "required": ["kind", "columns", "unnamed"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "rows" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
        "unnamed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["expression"],
            "additionalProperties": false,
            "properties": { "expression": { "type": "string" } }
          }
        }
      }
    },
    "changes": {
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "changes" },
        "fields": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": ["changes", "lastInsertId"] } }
      }
    },
    "signal": {
      "type": "object",
      "required": ["kind", "signal"],
      "additionalProperties": false,
      "properties": { "kind": { "const": "signal" }, "signal": { "type": "string" } }
    },
    "queued": {
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "queued" },
        "fields": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": ["callId", "queued"] } }
      }
    },
    "call": {
      "type": "object",
      "required": ["method", "url", "body", "answer"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "url": { "type": "string" },
        "body": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["value"],
                "additionalProperties": false,
                "properties": { "value": { "type": ["string", "number", "boolean", "null"] } }
              }
            ]
          }
        },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "required": ["secret", "header", "scheme"],
              "additionalProperties": false,
              "properties": { "secret": { "type": "string" }, "header": { "type": "string" }, "scheme": { "type": "string" } }
            },
            {
              "type": "object",
              "required": ["key"],
              "additionalProperties": false,
              "properties": { "key": { "type": "string" } }
            }
          ]
        },
        "then": {
          "type": "object",
          "required": ["action", "inputs"],
          "additionalProperties": false,
          "properties": { "action": { "type": "string" }, "inputs": { "type": "object", "additionalProperties": { "type": "string" } } }
        },
        "answer": { "type": "string" }
      }
    },
    "caller": {
      "type": "object",
      "required": ["kind", "proof", "actor"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["visitor", "person", "service"] },
        "proof": { "type": "string" },
        "actor": { "enum": ["none", "user id", "key id"] }
      }
    },
    "http": {
      "type": "object",
      "required": ["method", "path", "input", "callers", "onlyDoor"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string" },
        "input": { "type": "string" },
        "signature": {
          "type": "object",
          "required": ["scheme", "header", "headers", "secret", "format", "windowSeconds", "acceptedOnce", "replay"],
          "additionalProperties": false,
          "properties": {
            "scheme": { "enum": ["konae", "hmac-body", "timestamped", "svix"] },
            "header": { "type": "string" },
            "headers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "secret": { "type": "string" },
            "format": { "type": "string" },
            "windowSeconds": { "type": ["integer", "null"], "minimum": 1 },
            "acceptedOnce": { "const": true },
            "replay": { "type": "string" },
            "algorithm": { "enum": ["sha256", "sha1"] },
            "encoding": { "enum": ["hex", "base64"] },
            "prefix": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "callers": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/caller" } },
        "declaredCallers": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["signature", "key", "session"] } },
        "onlyDoor": { "enum": ["always", "on a private Deployment"] }
      }
    },
    "error": {
      "type": "object",
      "required": ["message", "when", "via"],
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string" },
        "when": { "type": "string" },
        "via": { "enum": ["runtime", "http", "both"] },
        "status": { "type": "integer", "minimum": 100 }
      }
    },
    "limits": {
      "type": "object",
      "required": ["limit", "bound", "maxRows", "maxResultBytes", "statementSeconds", "rate"],
      "additionalProperties": false,
      "properties": {
        "limit": { "type": ["integer", "null"], "minimum": 0 },
        "bound": { "enum": ["limit", "single-row", "none"] },
        "maxRows": { "type": "integer", "minimum": 1 },
        "maxResultBytes": { "type": "integer", "minimum": 1 },
        "statementSeconds": { "type": "integer", "minimum": 1 },
        "rate": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["caller", "calls", "seconds"],
            "additionalProperties": false,
            "properties": {
              "caller": { "type": "string" },
              "calls": { "type": "integer", "minimum": 1 },
              "seconds": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "maxRequestBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object", "required": ["source", "key"], "additionalProperties": false,
          "properties": { "source": { "const": "input" }, "key": { "type": "string" } }
        },
        {
          "type": "object", "required": ["source", "field"], "additionalProperties": false,
          "properties": { "source": { "const": "actor" }, "field": { "enum": ["id", "role"] } }
        },
        {
          "type": "object", "required": ["source", "field"], "additionalProperties": false,
          "properties": { "source": { "const": "kernel" }, "field": { "const": "now" } }
        },
        {
          "type": "object", "required": ["source", "value"], "additionalProperties": false,
          "properties": { "source": { "const": "literal" }, "value": { "type": ["string", "number", "null"] } }
        }
      ]
    }
  }
}
