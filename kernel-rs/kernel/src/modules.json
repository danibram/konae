{
  "modules": {
    "auth": {
      "summary": "Who is using the app. The Kernel owns accounts and sessions; the app only reads the current one.",
      "switch": true,
      "options": [
        {
          "key": "signupPolicy",
          "type": "signup-policy",
          "values": [
            "open",
            "allowlist",
            "invitation",
            "closed"
          ],
          "valueLabels": {
            "open": "Open",
            "allowlist": "Allowlist",
            "invitation": "Invitation only",
            "closed": "Closed"
          },
          "default": null,
          "label": "Who can create an account",
          "help": "Choose who may create an app account. Allowlist entries stay as separate email addresses or domains."
        },
        {
          "key": "signInMethods",
          "type": "sign-in-methods",
          "values": [
            "password",
            "google"
          ],
          "valueLabels": {
            "password": "Email and password",
            "google": "Continue with Google"
          },
          "default": [
            "password"
          ],
          "label": "Sign-in methods",
          "help": "Password stays on. Google needs this app's Google client set as signing secrets."
        }
      ],
      "permission": "manage_users",
      "agentRule": "after-owner-confirms",
      "requires": [],
      "uses": [
        "private deployment",
        "app accounts or invitations",
        "authenticated actions",
        "actor bindings"
      ],
      "data": {
        "version": 1,
        "components": [
          "identity"
        ]
      }
    },
    "actions": {
      "summary": "The only door to the database. A call names a Server Action declared in actions.json and passes its input; the Kernel authorizes the caller, binds the input and runs the action's one SQL statement, or records its Signal.",
      "switch": true,
      "options": [],
      "permission": "publish",
      "agentRule": "after-owner-confirms",
      "requires": [],
      "uses": [
        "actions.json",
        "schema.sql",
        "miniapp.actions"
      ],
      "data": {
        "version": 2,
        "reserved": [
          "__konae_schema_state",
          "__konae_schema_history",
          "__konae_notify_intents"
        ],
        "components": [
          "database"
        ],
        "migrations": [
          "schema-transforms",
          "notify-intents"
        ]
      }
    },
    "page": {
      "summary": "Values from the page address. The Kernel fills params when a declared page path answers.",
      "switch": false,
      "options": [],
      "permission": "publish",
      "agentRule": "never",
      "requires": [
        "actions"
      ],
      "uses": [
        "actions.json"
      ]
    },
    "files": {
      "summary": "Small files stored by the Kernel for one Deployment. The module option can require an app session to read every file.",
      "switch": true,
      "options": [
        {
          "key": "fileAccess",
          "type": "enum",
          "values": [
            "app-users"
          ],
          "valueLabels": {
            "app-users": "All signed-in users"
          },
          "defaultLabel": "Only the uploader",
          "default": null,
          "label": "Who can read every file",
          "help": "Let every signed-in user read all files in this app."
        }
      ],
      "permission": "publish",
      "agentRule": "never",
      "requires": [
        "auth"
      ],
      "uses": [
        "miniapp.files"
      ],
      "data": {
        "version": 1,
        "components": [
          "files"
        ],
        "objects": "file-index"
      }
    },
    "calls": {
      "summary": "Calls from this app to another app or an outside service, made by the Kernel from its own process, never from the browser. There is no browser call: the page invokes the call action with miniapp.actions.call, which answers { callId, queued: true }, and the Kernel sends the request, retries it and runs the then mutation with the answer.",
      "switch": true,
      "options": [],
      "permission": "publish",
      "agentRule": "after-owner-confirms",
      "requires": [
        "actions"
      ],
      "uses": [
        "actions.json kind=call"
      ],
      "data": {
        "version": 1,
        "components": [
          "database"
        ],
        "reserved": [
          "__konae_calls"
        ],
        "migrations": [
          "calls-app-outbox"
        ]
      }
    },
    "http": {
      "summary": "Routes on the Deployment's own host for programs and other services: a JSON endpoint, a webhook, a file a program fetches. There is no browser call; the app's own pages keep using miniapp.actions.call, and may use a file's route as an img src.",
      "switch": true,
      "options": [],
      "permission": "publish",
      "agentRule": "after-owner-confirms",
      "requires": [
        "actions"
      ],
      "uses": [
        "actions.json http"
      ]
    },
    "seo": {
      "summary": "Canonical addresses and page cards for HTML pages, robots.txt and a sitemap when the owner turns search listing on.",
      "switch": true,
      "options": [
        {
          "key": "canonical",
          "type": "enum",
          "values": [
            "domain",
            "hostname",
            "path"
          ],
          "valueLabels": {
            "domain": "Custom domain",
            "hostname": "Generated hostname",
            "path": "Path address"
          },
          "defaultLabel": "Use the default address",
          "default": null,
          "label": "Canonical address",
          "help": "Choose the address search engines and link previews should use."
        },
        {
          "key": "image",
          "type": "path",
          "valuesFrom": "app-images",
          "default": null,
          "label": "Card image",
          "help": "Choose an image path from the app's published files."
        }
      ],
      "permission": "publish",
      "agentRule": "after-owner-confirms",
      "requires": [],
      "uses": [
        "HTML pages with a title"
      ]
    },
    "functions": {
      "summary": "Run bundled JavaScript handlers on the Kernel with verified identity and named Server Actions.",
      "switch": true,
      "options": [],
      "permission": "publish",
      "agentRule": "after-owner-confirms",
      "requires": [],
      "uses": [
        "functions.json",
        "crons.json"
      ],
      "data": {
        "version": 1,
        "components": [
          "database"
        ],
        "reserved": [
          "__konae_function_receipts"
        ],
        "migrations": [
          "function-receipts"
        ]
      }
    },
    "documents": {
      "summary": "Issue portable PDFs from mutation snapshots and serve them through an app-owned read rule.",
      "switch": true,
      "options": [],
      "permission": "publish",
      "agentRule": "after-owner-confirms",
      "requires": [
        "actions",
        "auth"
      ],
      "uses": [
        "actions.json issue and download declarations"
      ],
      "data": {
        "version": 1,
        "components": [
          "database",
          "files"
        ],
        "reserved": [
          "__konae_documents"
        ],
        "migrations": [
          "documents-v1"
        ],
        "objects": "documents"
      }
    },
    "usage": {
      "summary": "Per-app usage records.",
      "switch": false,
      "options": [],
      "permission": "publish",
      "agentRule": "never",
      "requires": [],
      "uses": [],
      "data": {
        "version": 1,
        "components": [
          "usage"
        ]
      }
    }
  }
}
