  {
   "case": "a signed route whose secret is set",
   "actions": {
    "orders.receive": {
     "kind": "mutation",
     "access": "anonymous",
     "statement": "INSERT INTO orders (external_id) VALUES (?1)",
     "bindings": [
      {
       "source": "input",
       "key": "id",
       "type": "string"
      }
     ],
     "http": {
      "method": "POST",
      "path": "/hooks/orders",
      "signature": {
       "header": "X-Signature",
       "secret": "orders_webhook"
      }
     }
    }
   },
   "secrets": [
    {
     "name": "orders_webhook",
     "use": "route"
    }
   ],
   "error": null
  },
