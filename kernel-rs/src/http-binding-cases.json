 {
  "case": "a GitHub-style signature with fields into a nested body",
  "actions": {
   "hooks.receive": {
    "kind": "mutation",
    "access": "anonymous",
    "bindings": [
     {
      "source": "input",
      "key": "id",
      "type": "string",
      "maxLength": 100
     },
     {
      "source": "input",
      "key": "title",
      "type": "string",
      "maxLength": 200
     },
     {
      "source": "kernel",
      "field": "now"
     }
    ],
    "http": {
     "method": "POST",
     "path": "/hooks/provider",
     "signature": {
      "scheme": "hmac-body",
      "header": "X-Hub-Signature-256",
      "secret": "github_webhook",
      "algorithm": "sha256",
      "encoding": "hex",
      "prefix": "sha256="
     },
     "fields": {
      "id": "$.issue.node_id",
      "title": "$.issue.title"
     }
    },
    "statement": "INSERT INTO orders (external_id, note, created_at) VALUES (?1, ?2, ?3)"
   }
  },
  "error": null
