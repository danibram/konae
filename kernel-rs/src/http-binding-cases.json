 {
  "case": "a route whose action binds the caller's role",
  "actions": {
   "orders.remove": {
    "kind": "mutation",
    "access": "anonymous",
    "statement": "DELETE FROM orders WHERE external_id = ?1 AND ?2 = 'owner'",
    "bindings": [
