{
  "name": "konae",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "bin": {
    "konae": "scripts/konae.ts"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:local": "bun run scripts/dev-local.ts",
    "kernel": "KONAE_DATA_DIR=${KONAE_DATA_DIR:-data/kernel-local} cargo run --manifest-path kernel-rs/Cargo.toml --bin konae",
    "build": "tsc -b && vite build --config vite.config.ts",
    "test": "bun test --timeout 30000",
    "test:e2e": "playwright test",
    "test:durable-mvp": "VITE_KONAE_DURABLE_STAGING=true bun run build && RUSTUP_TOOLCHAIN=1.91.0 cargo build --locked --manifest-path kernel-rs/Cargo.toml --bin konae && playwright test --config tests/durable-mvp/playwright.config.ts",
    "test:durable-mvp:access": "bun tests/durable-mvp/history-access.mjs \"$PWD\" \"$PWD/kernel-rs/target/debug/konae\"",
    "test:durable-mvp:format": "bun tests/durable-mvp/format-compatibility.mjs \"$PWD/kernel-rs/target/debug/konae\"",
    "test:durable-mvp:export": "bun tests/durable-mvp/app-export.mjs \"$PWD\"",
    "test:durable-mvp:confirmation": "bun tests/durable-mvp/confirmation.mjs \"$PWD\"",
    "test:durable-mvp:native-profile": "bun tests/durable-mvp/native-handoff-profile.mjs \"$PWD/kernel-rs/target/debug/konae\"",
    "test:durable-mvp:native-profile:bounded": "KONAE_PROFILE_NATIVE_LIMIT=250 KONAE_PROFILE_NATIVE_BYTES=786432 bun tests/durable-mvp/native-handoff-profile.mjs \"$PWD/kernel-rs/target/debug/konae\"",
    "test:durable-mvp:providers": "bun scripts/durable-provider-smoke.mjs \"$PWD\"",
    "test:e2e:minio": "playwright test --config playwright.minio.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "konae": "bun run scripts/konae.ts",
    "docs:site": "bun run scripts/docs-site.ts",
    "home:site": "bun run scripts/home-site.ts",
    "sdk:render": "bun run scripts/render-sdk.ts",
    "templates:render": "bun run scripts/render-templates.ts",
    "ui:render": "bun run scripts/render-app-ui.ts",
    "release:local": "bash scripts/release-local.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@konae/pi-ai-durable": "npm:@earendil-works/pi-ai@1.5.2",
    "esbuild-wasm": "0.25.12",
    "lucide-react": "^0.468.0",
    "marked": "18.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
