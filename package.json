{
  "name": "konae",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "bin": { "konae": "scripts/konae.ts" },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:local": "bun run scripts/dev-local.ts",
    "kernel": "KONAE_DATA_DIR=${KONAE_DATA_DIR:-data/kernel-local} cargo run --manifest-path kernel-rs/Cargo.toml --bin konae",
    "dev:stack": "docker compose up --build",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview",
    "test": "bun test --timeout 30000",
    "test:e2e": "playwright test",
    "test:e2e:minio": "playwright test --config playwright.minio.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "konae": "bun run scripts/konae.ts",
    "docs:site": "bun run scripts/docs-site.ts",
    "sdk:render": "bun run scripts/render-sdk.ts",
    "templates:render": "bun run scripts/render-templates.ts",
    "ui:render": "bun run scripts/render-app-ui.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "esbuild-wasm": "0.25.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
